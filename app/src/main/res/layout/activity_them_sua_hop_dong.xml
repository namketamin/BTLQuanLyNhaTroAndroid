<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ThemSuaHopDongActivity">

    <!-- Header Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:id="@+id/txtTieuDeHopDong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tạo hợp đồng"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Nội dung cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Thông tin Nhà trọ & Phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhà trọ"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTenNhaTroHD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhà trọ Hoa Mai"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/txtDiaChiNhaTroHD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="18 Nguyễn Văn Cừ"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtTenPhongHD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phòng P101"
                    android:textColor="#245C45"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Chọn Người đại diện -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Người đại diện"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtSearchNguoiThueHD"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edittext"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="Tìm theo số điện thoại, CCCD, họ tên..."
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textColorHint="#888888" />

            <LinearLayout
                android:id="@+id/layoutDanhSachNguoiThueHD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- Thời hạn hợp đồng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày bắt đầu"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtNgayBatDau"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:drawableEnd="@drawable/ic_calendar"
                android:focusable="false"
                android:clickable="true"
                android:hint="DD/MM/YYYY"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày kết thúc"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtNgayKetThuc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:drawableEnd="@drawable/ic_calendar"
                android:focusable="false"
                android:clickable="true"
                android:hint="DD/MM/YYYY"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#888888" />

            <!-- Các khoản tiền & đơn giá (Tự động lấy từ nhà trọ & phòng) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá phòng (đ/tháng)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtGiaPhong"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn giá điện (đ/kWh)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtDonGiaDien"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn giá nước (đ/m³)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtDonGiaNuoc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phí Internet (đ/tháng)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtPhiInternet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phí dịch vụ (đ/tháng)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtPhiDichVu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiền cọc (đ)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtTienCoc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Nút Lưu hợp đồng -->
            <Button
                android:id="@+id/btnLuuHopDong"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#245C45"
                android:text="Lưu hợp đồng"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>