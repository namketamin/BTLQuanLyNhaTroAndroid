<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".NhaTroActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Danh sách nhà trọ"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tìm kiếm -->
            <include
                layout="@layout/layout_search"
                android:id="@+id/layoutSearchNhaTro" />

            <!-- Danh sách nhà trọ -->
            <LinearLayout
                android:id="@+id/layoutDanhSachNhaTro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical" />

            <!-- Thêm nhà trọ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemNhaTro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/forest"
                android:text="Thêm nhà trọ"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:icon="@drawable/ic_plus"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#FFFFFF" />

            <!-- Lối tắt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNguoiThue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:text="Người thuê"
                    android:textColor="@color/forest"
                    android:textSize="13sp"
                    app:strokeColor="#D5E0D5"
                    app:strokeWidth="1dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHopDong"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:text="Hợp đồng"
                    android:textColor="@color/forest"
                    android:textSize="13sp"
                    app:strokeColor="#D5E0D5"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation dùng chung -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>