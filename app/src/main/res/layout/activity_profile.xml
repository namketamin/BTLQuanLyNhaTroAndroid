<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ProfileActivity">

    <!-- Header Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hồ sơ cá nhân"
            android:textColor="#2C3E50"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nội dung chi tiết hồ sơ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Avatar -->
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/ic_menu_myplaces"
                android:backgroundTint="#CCCCCC"
                android:padding="20dp" />

            <!-- Tên hiển thị -->
            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Nguyễn Văn A"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Số điện thoại -->
            <TextView
                android:id="@+id/txtPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="0987 654 321"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Email -->
            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="nguyenvana@gmail.com"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Nút Cập nhật hồ sơ -->
            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/forest"
                android:elevation="1dp"
                android:text="Cập nhật hồ sơ"
                android:textStyle="bold" />

            <!-- Nút Đổi mật khẩu -->
            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/forest"
                android:elevation="1dp"
                android:text="Đổi mật khẩu"
                android:textStyle="bold" />

            <!-- Nút dành riêng cho Admin -->
            <Button
                android:id="@+id/btnQuanLyChuTro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/forest"
                android:elevation="1dp"
                android:text="Quản lý tài khoản chủ trọ"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Nút Đăng xuất -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="1dp"
                android:text="Đăng xuất"
                android:textColor="#E74C3C"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Thanh Menu Đáy dùng chung (Tab 5: Cá nhân) -->
    <include android:id="@+id/layoutBottomNav"
        layout="@layout/layout_bottom_nav" />

</LinearLayout>