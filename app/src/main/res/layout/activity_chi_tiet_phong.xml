<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ChiTietPhongActivity">

    <!-- Header Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chi tiết phòng"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Nội dung cuộn được -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Thông tin phòng & hợp đồng hiện tại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Tên phòng và trạng thái -->
                <TextView
                    android:id="@+id/txtTenPhongTrangThai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="P101 · Đang thuê"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Tên nhà trọ -->
                <TextView
                    android:id="@+id/txtTenNhaTro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Nhà trọ Hoa Mai"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <!-- Giá thuê & Diện tích -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá thuê"
                            android:textColor="#888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtGiaThue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2.500.000 đ/tháng"
                            android:textColor="#222222"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diện tích"
                            android:textColor="#888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtDienTich"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="20 m²"
                            android:textColor="#222222"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Đường kẻ ngang -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <!-- Khối Hợp đồng hiện tại -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hợp đồng hiện tại"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Người thuê -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Người thuê"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtNguoiThue_HD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Linh Trần"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Số hợp đồng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số hợp đồng"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtSoHopDong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD-HD001"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thời hạn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thời hạn"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtThoiHan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01/06/2026 – 31/05/2027"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nút Xem hợp đồng -->
                <Button
                    android:id="@+id/btnXemHopDong"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#245C45"
                    android:text="Xem hợp đồng"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Thao tác nhanh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thao tác nhanh"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Hàng 1 nút thao tác nhanh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btnLichSuHopDong"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginRight="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Hợp đồng"
                        android:textColor="#245C45"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle" />

                    <Button
                        android:id="@+id/btnNhanHoaDon"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Hóa đơn"
                        android:textColor="#245C45"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>

                <!-- Hàng 2 nút thao tác nhanh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSuaThongTin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginRight="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Sửa thông tin"
                        android:textColor="#245C45"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle" />

                    <Button
                        android:id="@+id/btnXoaPhong"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Xóa phòng"
                        android:textColor="#D32F2F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dòng ghi chú chân trang -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Chỉ xóa phòng khi chưa có dữ liệu nghiệp vụ liên quan"
                android:textColor="#888888"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>