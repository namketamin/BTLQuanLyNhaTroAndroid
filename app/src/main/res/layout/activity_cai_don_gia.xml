<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".CaiDonGiaActivity">

    <!-- Header Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thiết lập đơn giá"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Nội dung cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Ô 1: Giá điện -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá điện (đ/kWh)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtGiaDien"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Ô 2: Giá nước -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá nước (đ/m³)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtGiaNuoc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Ô 3: Phí Internet -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phí Internet (đ/tháng)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtPhiInternet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Ô 4: Phí dịch vụ cố định -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phí dịch vụ cố định (đ/tháng)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtPhiDichVu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Ghi chú giải thích -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đơn giá mới áp dụng cho hợp đồng mới và hóa đơn mới dùng đơn giá mặc định."
                android:textColor="#666666"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Nút Lưu thiết lập ở đáy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btnLuuThietLap"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#245C45"
            android:text="Lưu thiết lập"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>