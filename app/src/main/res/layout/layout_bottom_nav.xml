<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:weightSum="5">

    <!-- 1. Tổng quan -->
    <LinearLayout
        android:id="@+id/menuOverview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgOverview"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_overview" />
        <TextView
            android:id="@+id/txtOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng quan"
            android:textColor="#7F8C8D"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 2. Trọ -->
    <LinearLayout
        android:id="@+id/menuRoom"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgRoom"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_room" />
        <TextView
            android:id="@+id/txtRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trọ"
            android:textColor="#7F8C8D"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. Hóa đơn -->
    <LinearLayout
        android:id="@+id/menuBill"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgBill"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bill" />
        <TextView
            android:id="@+id/txtBill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hóa đơn"
            android:textColor="#7F8C8D"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 4. Thống kê -->
    <LinearLayout
        android:id="@+id/menuStats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgStats"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_stats" />
        <TextView
            android:id="@+id/txtStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thống kê"
            android:textColor="#7F8C8D"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 5. Cá nhân -->
    <LinearLayout
        android:id="@+id/menuProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_person" />
        <TextView
            android:id="@+id/txtProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cá nhân"
            android:textColor="#7F8C8D"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>