<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".HoaDonActivity">

    <!-- Header Tiêu đề chuẩn cân đối (Dùng RelativeLayout) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <!-- Nút Back nằm ở góc trái -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <!-- Tiêu đề luôn nằm chính giữa tuyệt đối -->
        <TextView
            android:id="@+id/txtTieuDeTrang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Danh sách hóa đơn"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Thanh tìm kiếm và Bộ lọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <include
            layout="@layout/layout_search"
            android:id="@+id/edtSearchHoaDon" />

        <!-- Hàng bộ lọc: Tháng, Năm, Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="8dp">

            <!-- Bộ lọc Tháng -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tháng"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/txtFilterThang"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Bộ lọc Năm -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Năm"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/txtFilterNam"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Bộ lọc Trạng thái -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/txtFilterTrangThai"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Danh sách hóa đơn cuộn được -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/layoutContainerHoaDon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Nút Thêm hóa đơn cố định ở đáy -->
    <LinearLayout
        android:id="@+id/layoutBottomThemHD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemHoaDon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#245C45"
            android:text="Thêm hóa đơn mới"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom navigation dùng chung -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>