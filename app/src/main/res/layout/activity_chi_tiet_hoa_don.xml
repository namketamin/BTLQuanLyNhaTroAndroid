<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ChiTietHoaDonActivity">

    <!-- Header Tiêu đề -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:id="@+id/txtTieuDeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="HĐ-1 · Chi tiết hóa đơn"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Nội dung chi tiết cuộn được -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card thông tin chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Phòng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Phòng" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietPhong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P101" android:textColor="#222222" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Người thuê -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Người thuê" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietNguoiThue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lê Hữu Dũng" android:textColor="#222222" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Ngày lập (THÊM MỚI) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ngày lập" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietNgayLap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15/11/2026" android:textColor="#222222" android:textSize="14sp"/>
                </LinearLayout>

                <!-- Hạn thanh toán -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hạn thanh toán" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietHanThanhToan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25/11/2026" android:textColor="#222222" android:textSize="14sp"/>
                </LinearLayout>

                <!-- Kỳ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kỳ" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietKy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11/2026" android:textColor="#222222" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Tiền phòng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền phòng" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietTienPhong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.500.000 đ" android:textColor="#222222" android:textSize="14sp"/>
                </LinearLayout>

                <!-- Tiền điện -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền điện" android:textColor="#666666" android:textSize="14sp"/>
                        <TextView android:id="@+id/txtChiTietTienDien" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="210.000 đ" android:textColor="#222222" android:textSize="14sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txtChiTietSubDien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỉ số 100 → 160 · 60 kWh (Đơn giá: 3.500 đ)"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Tiền nước -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền nước" android:textColor="#666666" android:textSize="14sp"/>
                        <TextView android:id="@+id/txtChiTietTienNuoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120.000 đ" android:textColor="#222222" android:textSize="14sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txtChiTietSubNuoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỉ số 20 → 28 · 8 m³ (Đơn giá: 15.000 đ)"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Tiền Internet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền Internet" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietInternet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70.000 đ" android:textColor="#222222" android:textSize="14sp"/>
                </LinearLayout>

                <!-- Tiền dịch vụ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền dịch vụ" android:textColor="#666666" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtChiTietDichVu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50.000 đ" android:textColor="#222222" android:textSize="14sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginBottom="12dp"/>

                <!-- Tổng tiền -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tổng tiền" android:textColor="#222222" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtChiTietTongTien" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.950.000 đ" android:textColor="#245C45" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Trạng thái -->
                <TextView
                    android:id="@+id/txtChiTietTrangThai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa thanh toán"
                    android:textColor="#D97706"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Nút Ghi nhận thanh toán -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGhiNhanThanhToan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#245C45"
                android:text="Ghi nhận thanh toán"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <!-- Nút Xuất / chia sẻ hóa đơn -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXuatHoaDon"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#245C45"
                app:strokeColor="#245C45"
                app:strokeWidth="1dp"
                android:text="Xuất / chia sẻ hóa đơn"
                android:textStyle="bold"/>

            <!-- Nút Sửa hóa đơn (CHỈ HIỆN KHI CHƯA THANH TOÁN) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuaHoaDon"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#245C45"
                app:strokeColor="#245C45"
                app:strokeWidth="1dp"
                android:text="Sửa hóa đơn"
                android:textStyle="bold" />

            <!-- Nút Xóa hóa đơn (CHỈ HIỆN KHI CHƯA THANH TOÁN) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXoaHoaDon"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#DC2626"
                app:strokeColor="#DC2626"
                app:strokeWidth="1dp"
                android:text="Xóa hóa đơn"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>