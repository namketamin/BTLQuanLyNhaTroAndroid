<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ThemSuaPhongActivity">

    <!-- Header Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:id="@+id/txtTieuDe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thêm phòng"
            android:textColor="#26352F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Nội dung form nhập -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tiêu đề + Ô nhập: Tên phòng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên phòng"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtTenPhong"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Tiêu đề + Ô nhập: Diện tích -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diện tích (m²)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtDienTich"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Tiêu đề + Ô nhập: Giá thuê -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá thuê (đ/tháng)"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edtGiaPhong"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_edittext"
                android:inputType="number"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="#222222" />

            <!-- Công tắc Đang bảo trì -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đang bảo trì"
                    android:textColor="#333333"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBaoTri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Nút Lưu phòng ở đáy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btnLuuPhong"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#245C45"
            android:text="Lưu phòng"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>