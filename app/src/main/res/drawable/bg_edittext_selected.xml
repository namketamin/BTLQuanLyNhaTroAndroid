<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Bo tròn 4 góc (đồng bộ với các card/edittext khác) -->
    <corners android:radius="8dp" />

    <!-- Màu nền nhạt (xanh lá rất nhạt) khi card được chọn -->
    <solid android:color="#EBF5F0" />

    <!-- Đường viền màu xanh chủ đạo (#245C45) để tạo điểm nhấn nổi bật -->
    <stroke
        android:width="2dp"
        android:color="#245C45" />

</shape>